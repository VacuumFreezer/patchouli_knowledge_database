{
  "name": "@patchouli/plugin",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "cmd.exe /d /s /c call .\\scripts\\run-with-codex-node.cmd .\\scripts\\build.mjs",
    "typecheck": "cmd.exe /d /s /c call .\\scripts\\run-with-codex-node.cmd .\\node_modules\\typescript\\bin\\tsc --noEmit",
    "test": "cmd.exe /d /s /c call .\\scripts\\run-with-codex-node.cmd .\\scripts\\test.mjs",
    "validate:skill": "cmd.exe /d /s /c call .\\scripts\\run-with-codex-node.cmd .\\scripts\\validate-skill.mjs",
    "verify:bundle": "cmd.exe /d /s /c call .\\scripts\\run-with-codex-node.cmd .\\scripts\\verify-bundle.mjs",
    "smoke:mcp": "cmd.exe /d /s /c call .\\scripts\\run-with-codex-node.cmd .\\scripts\\smoke-mcp.mjs",
    "smoke:hook": "cmd.exe /d /s /c call .\\scripts\\run-with-codex-node.cmd .\\scripts\\smoke-hook.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "katex": "^0.16.22",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^27.0.0",
    "typescript": "^7.0.2"
  }
}

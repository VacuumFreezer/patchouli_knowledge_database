{
  "name": "patchouli-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm --filter @patchouli/plugin build",
    "typecheck": "pnpm --filter @patchouli/plugin typecheck",
    "test": "pnpm --filter @patchouli/plugin test",
    "validate:skill": "pnpm --filter @patchouli/plugin validate:skill",
    "validate:plugin": "cmd.exe /d /s /c call .\\plugins\\patchouli\\scripts\\run-with-codex-node.cmd .\\scripts\\validate-plugin.mjs",
    "verify:bundle": "pnpm --filter @patchouli/plugin verify:bundle",
    "inspect:mcp": "pnpm --filter @patchouli/plugin smoke:mcp"
  }
}
